ANTHROPIC_API_KEY=
GROQ_API=
GPT_API=
GEMINI_API=
OLLAMA_PATH=http://localhost:11434

# Image PII redaction (agents/image_pii). Defaults already target Streamlit
# Community Cloud's free tier -- override only for a higher-memory host.
ENABLE_IMAGE_PII=true
PII_SPACY_MODEL_NAME=en_core_web_sm
PII_SPACY_MODEL_DIR=models/pii_spacy
WARM_UP_PII_ON_STARTUP=true
